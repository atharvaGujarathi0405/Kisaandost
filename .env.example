# Copy to .env and fill in. Never commit .env.

# HuggingFace token with access to the gated ai4bharat/indicconformer_stt_mr_hybrid_ctc_rnnt_large repo
HF_TOKEN=

# Optional ASR chunking overrides (CLI flags take precedence)
# ASR_CHUNK_SEC=20
# ASR_CHUNK_MAX_SEC=30
# ASR_CHUNK_OVERLAP_SEC=0

# Secret used to derive pseudonymous speaker IDs (VH_S###) from a private speaker key.
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Losing or changing it means returning speakers get new IDs. Keep it out of git.
SPEAKER_ID_SALT=

# Chat bot (bot/server.py). Backend only; never expose to the browser.
GROQ_API_KEY=
# KD_MODEL=openai/gpt-oss-20b

