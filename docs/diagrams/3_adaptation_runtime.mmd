flowchart TB
    subgraph P["Prepare the reply"]
        direction LR
        IN["Groq reply<br/>plain standard Marathi"] --> T["Tidy<br/>remove list marks"]
        T --> SP["Split into sentences"]
    end
    subgraph C["Check every sentence"]
        direction LR
        BY["ByT5 translator<br/>one sentence at a time"] --> G1{"Guard 1<br/>length 0.77 to 1.52<br/>times the source?"}
        G1 -- yes --> G2["Guard 2<br/>keep only word swaps<br/>seen in training"]
        G2 --> G3{"Guard 3<br/>negations unchanged?<br/>नाही, नको, नका"}
        G3 -- yes --> OK["Model sentence"]
        G1 -- no --> FB["Fallback<br/>keep Marathi sentence"]
        G3 -- no --> FB
        OK --> WR["Word rules<br/>नाही to नाई, आहे to हाय<br/>-ला to -ले on farm nouns"]
        FB --> WR
        WR --> OUT["Varhadi reply<br/>shown, then spoken"]
    end
    P --> C

    classDef net fill:#d9eaf4,stroke:#17668f,stroke-width:2px,color:#18211c;
    classDef server fill:#d9eee3,stroke:#1b6a4b,stroke-width:2px,color:#18211c;
    classDef model fill:#e6e1f7,stroke:#5642b0,stroke-width:2px,color:#18211c;
    classDef warn fill:#f8e1dc,stroke:#b3361f,stroke-width:2px,color:#18211c;
    classDef phone fill:#fbecd3,stroke:#a45d00,stroke-width:2px,color:#18211c;
    class IN net;
    class T,SP,WR server;
    class BY,G1,G2,G3,OK model;
    class FB warn;
    class OUT phone;
